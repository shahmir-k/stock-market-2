# ===========================================================================
# Personal Stock Market Simulator — Environment Variables
# ===========================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# Naming rules (PRD §14.2, §18.0):
#   - NEXT_PUBLIC_*  → exposed to the browser. Only safe-to-expose values.
#   - everything else → server-side only (Route Handlers, Server Components).
#
# Forbidden: NEXT_PUBLIC_TWELVE_DATA_API_KEY
# Forbidden: NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY
# ===========================================================================

# --- Twelve Data (server-only) ---------------------------------------------
# Used exclusively from /src/app/api/market/* route handlers.
# The browser must never see this value — DO NOT prefix with NEXT_PUBLIC_.
TWELVE_DATA_API_KEY=

# --- Supabase (browser-safe public keys) -----------------------------------
# Used by the client-side Supabase client (src/lib/supabase/client.ts) and
# by the SSR server client (src/lib/supabase/server.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase service role (server-only) -----------------------------------
# Bypasses RLS — only ever import in server-side code.
# Treat as a secret; rotate if exposed.
SUPABASE_SERVICE_ROLE_KEY=
